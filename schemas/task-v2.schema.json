{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-lord.local/schemas/task-v2.schema.json",
  "title": "Agent Lord task handle v2",
  "type": "object",
  "required": [
    "version",
    "task_id",
    "provider",
    "endpoint_id",
    "target",
    "route",
    "contract",
    "created_at",
    "updated_at",
    "last_operation_id"
  ],
  "properties": {
    "version": {"const": 2},
    "task_id": {"type": "string"},
    "provider": {"enum": ["claude-cli", "codex-cli", "mcode-cli", "codex-app"]},
    "endpoint_id": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "route": {
      "type": "object",
      "required": ["host_id", "resolved_at", "history"],
      "properties": {
        "host_id": {"type": ["string", "null"]},
        "resolved_at": {"type": "string"},
        "history": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "contract": {
      "type": "object",
      "required": ["model", "effort", "read_only", "permission_mode", "source", "retry_plan"],
      "properties": {
        "model": {"type": ["string", "null"], "description": "For mcode-cli this is the frozen provider/model or provider/model#variant literal."},
        "effort": {"type": ["string", "null"], "description": "Always null for mcode-cli because it has no independent effort control."},
        "read_only": {"type": "boolean"},
        "permission_mode": {"type": "string", "minLength": 1},
        "continuation_limit": {"type": "integer", "minimum": 0, "maximum": 5},
        "source": {
          "type": "object",
          "properties": {
            "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "verified_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          },
          "additionalProperties": false,
          "dependentRequired": {"verified_head_sha": ["head_sha"]}
        },
        "workspace": {
          "type": "object",
          "properties": {
            "policy": {"enum": ["exact-target", "reuse-or-create", "shared-readonly", "isolated"]},
            "repository": {"type": "string", "minLength": 1},
            "source_branch": {"type": "string", "minLength": 1},
            "workspace_branch": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "parallel_plan": {
          "type": "object",
          "properties": {
            "group": {"type": "string", "minLength": 1},
            "role": {"enum": ["worker", "integrator"]},
            "integration_target_branch": {"type": "string", "minLength": 1},
            "integrator_task_id": {"type": "string", "minLength": 1},
            "integration_order": {"type": "integer", "minimum": 1},
            "integration_workers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "additionalProperties": false
        },
        "retry_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["model", "attempts"],
            "properties": {
              "model": {"type": ["string", "null"]},
              "attempts": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "last_operation_id": {"type": ["string", "null"]},
    "lineage": {
      "type": "object",
      "description": "Immutable after task creation: how this continuation task came to exist. It never implies session migration or endpoint reuse.",
      "required": [
        "kind",
        "handoff_id",
        "handoff_operation_id",
        "packet_sha256",
        "source_session_kind",
        "source_session_id",
        "source_session_identity",
        "relationship"
      ],
      "properties": {
        "kind": {"const": "handoff"},
        "handoff_id": {"type": "string"},
        "handoff_operation_id": {"type": "string"},
        "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_session_kind": {"type": "string", "minLength": 1},
        "source_session_id": {"type": ["string", "null"]},
        "source_session_identity": {"enum": ["caller-declared", "unavailable"]},
        "relationship": {"const": "continues_user_task"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"provider": {"const": "mcode-cli"}}, "required": ["provider"]},
      "then": {
        "properties": {
          "contract": {
            "properties": {
              "model": {"type": "string", "pattern": "^[^\\s/#]+/[^\\s#]+(?:#[^\\s#]+)?$"},
              "effort": {"const": null},
              "read_only": {"const": false},
              "permission_mode": {"const": "dangerously_bypass"}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
