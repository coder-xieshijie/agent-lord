{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-lord.local/schemas/result-v1.schema.json",
  "title": "Agent Lord result envelope v1",
  "type": "object",
  "required": ["version", "status"],
  "properties": {
    "version": {"const": 1},
    "status": {
      "enum": ["RUNNING", "ACTION_REQUIRED", "SUCCEEDED", "ERROR", "NEEDS_DECISION", "CHECKPOINT_ACTIONABLE", "CHECKPOINT_QUIET", "IDLE"]
    },
    "task_id": {"type": "string"},
    "operation_id": {"type": "string"},
    "provider": {"type": "string"},
    "endpoint_id": {"type": "string"},
    "expected": {"type": "object"},
    "invocation": {"$ref": "operation-v1.schema.json#/properties/invocation"},
    "provider_return_code": {"type": ["integer", "null"]},
    "timing": {
      "type": "object",
      "required": ["created_at_ms", "completed_at_ms"],
      "properties": {
        "created_at_ms": {"type": "number"},
        "completed_at_ms": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["text", "read_at_ms"],
      "properties": {
        "text": {"type": "string"},
        "read_at_ms": {"type": "number"}
      },
      "additionalProperties": false
    },
    "observed": {
      "type": "object",
      "properties": {
        "models": {"type": "array", "items": {"type": "string"}},
        "model": {"type": "string"},
        "model_verification": {"type": "string"},
        "variant": {"type": ["string", "null"]},
        "variant_verification": {"type": "string"},
        "effort": {"type": ["string", "null"]},
        "effort_verification": {"type": "string"},
        "permission_mode": {"type": "string"},
        "permission_enforcement": {"type": "string"},
        "run_id": {"type": "string"},
        "session_id": {"type": "string"},
        "turn_id": {"type": "string"},
        "terminal_status": {"type": "string"},
        "provider_completed_at_ms": {"type": "number"},
        "progress_seq": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "source": {"type": "object"},
    "workspace": {"type": "object"},
    "parallel_plan": {"type": "object"},
    "continuation": {
      "type": "object",
      "required": ["parent_operation_id", "root_operation_id", "attempt", "limit"],
      "properties": {
        "parent_operation_id": {"type": "string"},
        "root_operation_id": {"type": "string"},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 5},
        "limit": {"type": "integer", "minimum": 1, "maximum": 5}
      },
      "additionalProperties": true
    },
    "delivery": {
      "type": "object",
      "required": ["status", "scope", "checks"],
      "properties": {
        "status": {"enum": ["verified", "incomplete", "unverified"]},
        "scope": {"const": "declared-files-and-commit"},
        "checks": {"type": "array", "items": {"type": "object"}},
        "commit_sha": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "description": "Public handoff lineage summary: digests and provenance only, never the packet body.",
      "properties": {
        "schema": {"const": "handoff-v1"},
        "handoff_id": {"type": "string"},
        "relationship": {"const": "continues_user_task"},
        "source_session": {"type": "object"},
        "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "packet_bytes": {"type": "integer", "minimum": 1},
        "workspace_snapshot": {"type": "object"},
        "validated_only": {"const": true}
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["code", "source", "model"],
            "properties": {
              "code": {"type": "string"},
              "source": {"type": "string"},
              "model": {"type": "string"}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["code", "source_format", "expected_effort"],
            "properties": {
              "code": {"const": "EFFORT_UNVERIFIABLE_FORMAT"},
              "source_format": {"type": "string"},
              "expected_effort": {"type": "string"}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "action": {
      "type": "object",
      "required": ["action_id", "tool", "arguments"],
      "properties": {
        "action_id": {"type": "string"},
        "tool": {"type": "string"},
        "arguments": {"type": "object"}
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable", "requires_authorization"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "retryable": {"type": "boolean"},
        "requires_authorization": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "actionable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "status"],
        "properties": {
          "version": {"const": 1},
          "status": {"enum": ["ACTION_REQUIRED", "SUCCEEDED", "ERROR", "NEEDS_DECISION"]},
          "task_id": {"type": "string"},
          "operation_id": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "active": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "operation_id", "provider", "operation_status"],
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "CHECKPOINT_ACTIONABLE"}}},
      "then": {"required": ["actionable", "active"]}
    },
    {
      "if": {"properties": {"status": {"const": "CHECKPOINT_QUIET"}}},
      "then": {"required": ["active"]}
    }
  ],
  "additionalProperties": true
}
