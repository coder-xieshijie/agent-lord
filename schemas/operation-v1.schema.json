{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-lord.local/schemas/operation-v1.schema.json",
  "title": "Agent Lord operation v1",
  "type": "object",
  "required": [
    "version",
    "operation_id",
    "task_id",
    "provider",
    "kind",
    "target",
    "status",
    "message_sha256",
    "expected",
    "observed",
    "source",
    "read_only",
    "artifact",
    "error",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "version": {"const": 1},
    "operation_id": {"type": "string"},
    "task_id": {"type": "string"},
    "provider": {"enum": ["claude-cli", "codex-cli", "codex-app"]},
    "kind": {"enum": ["start", "turn"]},
    "target": {"type": "string"},
    "status": {
      "enum": ["preparing", "running", "recovering", "awaiting_action", "submitted", "succeeded", "failed", "needs_decision"]
    },
    "message": {"type": "string"},
    "message_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected": {"type": "object"},
    "observed": {
      "type": "object",
      "properties": {
        "main_model": {"type": "string"},
        "main_model_verified": {"type": "boolean"},
        "main_model_evidence": {"type": "array", "items": {"type": "string"}},
        "auxiliary_models": {"type": "array", "items": {"type": "object"}},
        "warnings": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "source": {"type": "object"},
    "read_only": {"type": "boolean"},
    "workspace": {"type": "object"},
    "parallel_plan": {"type": "object"},
    "artifact": {"type": ["object", "null"]},
    "error": {"type": ["object", "null"]},
    "controller_pid": {"type": ["integer", "null"]},
    "recovery_controller_pid": {"type": ["integer", "null"]},
    "active_attempt": {
      "type": ["object", "null"],
      "properties": {
        "controller_pid": {"type": ["integer", "null"]},
        "pid": {"type": ["integer", "null"]},
        "process_group_id": {"type": ["integer", "null"]},
        "prompt_delivery": {"enum": ["not-delivered", "delivery-unknown", "stdin-attached"]}
      },
      "additionalProperties": true
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": true
}
