{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "交接 · Handoff",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "source",
      "label": "原主会话与 Runtime"
    },
    {
      "id": "target",
      "label": "新的本地 CLI 执行端"
    },
    {
      "id": "delivery",
      "label": "交付记录"
    }
  ],
  "mainPath": [
    "context",
    "packet",
    "gate",
    "continue",
    "supervise",
    "result"
  ],
  "nodes": [
    {
      "id": "context",
      "lane": "source",
      "col": 0,
      "type": "frontend",
      "label": "当前可见上下文",
      "sublabel": "目标、进展、证据与边界",
      "width": 160
    },
    {
      "id": "packet",
      "lane": "source",
      "col": 1,
      "type": "database",
      "label": "脱敏交接包",
      "sublabel": "handoff-v1 + 完整性摘要",
      "width": 160
    },
    {
      "id": "gate",
      "lane": "source",
      "col": 2,
      "type": "security",
      "label": "派发前核验",
      "sublabel": "契约、工作区快照与租约",
      "width": 160
    },
    {
      "id": "continue",
      "lane": "target",
      "col": 2,
      "type": "backend",
      "label": "新建续做会话",
      "sublabel": "Claude / Codex / MCode",
      "width": 160
    },
    {
      "id": "supervise",
      "lane": "target",
      "col": 3,
      "type": "backend",
      "label": "继续与监督",
      "sublabel": "turn / checkpoint / recover",
      "width": 160
    },
    {
      "id": "result",
      "lane": "delivery",
      "col": 3,
      "type": "frontend",
      "label": "结果与来源关系",
      "sublabel": "新 task_id + endpoint_id",
      "width": 160
    }
  ],
  "edges": [
    {
      "id": "context-packet",
      "from": "context",
      "to": "packet",
      "label": "剩余任务与验收条件"
    },
    {
      "id": "packet-gate",
      "from": "packet",
      "to": "gate",
      "label": "handoff --target"
    },
    {
      "id": "gate-continue",
      "from": "gate",
      "to": "continue",
      "label": "核验通过才启动"
    },
    {
      "id": "continue-supervise",
      "from": "continue",
      "to": "supervise",
      "label": "保存新执行端"
    },
    {
      "id": "supervise-result",
      "from": "supervise",
      "to": "result",
      "label": "核验终态与产物"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "工作区保持连续",
      "items": [
        "在指定的现有工作区续做，支持未提交改动",
        "Runtime 在租约内冻结 HEAD 与变更内容摘要"
      ]
    },
    {
      "dot": "amber",
      "title": "一个续做角色",
      "items": [
        "仅启动一个本地 CLI；主会话仍负责调度",
        "不读取原生会话 transcript，不迁移原生 Session"
      ]
    },
    {
      "dot": "emerald",
      "title": "可追溯与可重放",
      "items": [
        "保存交接包摘要、工作区快照和 lineage",
        "相同请求重放复用已有操作，不重复启动执行端"
      ]
    }
  ]
}
