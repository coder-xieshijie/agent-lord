{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "交叉审查 · Cross-Review",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "review",
      "label": "固定源码与双向审查"
    },
    {
      "id": "audit",
      "label": "独立复核与交付"
    },
    {
      "id": "exception",
      "label": "未决项出口",
      "variant": "exception"
    },
    {
      "id": "delivery",
      "label": "审查报告"
    }
  ],
  "mainPath": [
    "pin",
    "initial",
    "exchange",
    "ledger",
    "checker",
    "result"
  ],
  "nodes": [
    {
      "id": "pin",
      "lane": "review",
      "col": 0,
      "type": "database",
      "label": "固定审查范围",
      "sublabel": "同一 head / base SHA",
      "width": 160
    },
    {
      "id": "initial",
      "lane": "review",
      "col": 1,
      "type": "backend",
      "label": "两端独立初审",
      "sublabel": "MCode 与 Codex 并发",
      "width": 160
    },
    {
      "id": "exchange",
      "lane": "review",
      "col": 2,
      "type": "backend",
      "label": "两端互审",
      "sublabel": "交换脱敏产物，并发质证",
      "width": 160
    },
    {
      "id": "ledger",
      "lane": "review",
      "col": 3,
      "type": "security",
      "label": "逐项收敛",
      "sublabel": "可选一轮，仅处理分歧",
      "width": 160
    },
    {
      "id": "stop",
      "lane": "exception",
      "col": 3,
      "type": "external",
      "label": "保留分歧并停止",
      "sublabel": "UNRESOLVED",
      "width": 160
    },
    {
      "id": "checker",
      "lane": "audit",
      "col": 3,
      "type": "backend",
      "label": "独立 MCode 复核",
      "sublabel": "全新 Session，去共识标签",
      "width": 160
    },
    {
      "id": "result",
      "lane": "delivery",
      "col": 3,
      "type": "frontend",
      "label": "交付审查结论",
      "sublabel": "流程状态与代码结论分列",
      "width": 160
    }
  ],
  "edges": [
    {
      "id": "pin-initial",
      "from": "pin",
      "to": "initial",
      "label": "同一验收口径"
    },
    {
      "id": "initial-exchange",
      "from": "initial",
      "to": "exchange",
      "label": "两份初审均已核验"
    },
    {
      "id": "exchange-ledger",
      "from": "exchange",
      "to": "ledger",
      "label": "证据、严重度、最小修复"
    },
    {
      "id": "ledger-stop",
      "from": "ledger",
      "to": "stop",
      "label": "仍有分歧"
    },
    {
      "id": "ledger-checker",
      "from": "ledger",
      "to": "checker",
      "label": "无未决项"
    },
    {
      "id": "checker-result",
      "from": "checker",
      "to": "result",
      "label": "独立审计已核验"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "角色与隔离",
      "items": [
        "默认 MCode：Opus 5 / xhigh；Codex：GPT-6 Astra / max",
        "每个角色独立 worktree；保持源码与 HEAD 不变"
      ]
    },
    {
      "dot": "amber",
      "title": "有界收敛",
      "items": [
        "常规共 5 次操作；可选收敛后共 7 次",
        "保留 DROPPED 记录供独立复核，不以多数票代替证据"
      ]
    },
    {
      "dot": "emerald",
      "title": "两项结论",
      "items": [
        "Pipeline Check：角色、源码、屏障和复核是否有效",
        "Review Result：是否仍有已确认的问题"
      ]
    }
  ]
}
