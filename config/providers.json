{
  "version": 1,
  "control": {
    "checkpoint_seconds": 120,
    "dead_process_result_grace_seconds": 5,
    "finalize_lock_attempts": 40,
    "finalize_lock_retry_interval_ms": 50,
    "claude_stall_seconds": 900,
    "claude_tool_stall_seconds": 3600,
    "claude_terminate_grace_seconds": 10,
    "claude_progress_poll_interval_ms": 250,
    "mcode_terminate_grace_seconds": 10,
    "mcode_progress_poll_interval_ms": 100
  },
  "providers": {
    "claude-cli": {
      "binary_env": "AGENT_LORD_CLAUDE_BIN",
      "default_binary": "claude",
      "default_model": "claude-fable-5",
      "default_effort": "xhigh",
      "default_resolution": {
        "source": "provider-config",
        "config_dir_env": "CLAUDE_CONFIG_DIR",
        "default_config_dir": "~/.claude",
        "settings_file": "settings.json",
        "model_key": "model",
        "effort_key": "effortLevel",
        "environment_key": "env",
        "model_environment_keys": [
          "ANTHROPIC_MODEL",
          "ANTHROPIC_DEFAULT_MODEL",
          "ANTHROPIC_DEFAULT_OPUS_MODEL",
          "ANTHROPIC_DEFAULT_SONNET_MODEL",
          "ANTHROPIC_DEFAULT_HAIKU_MODEL",
          "ANTHROPIC_DEFAULT_FABLE_MODEL",
          "ANTHROPIC_SMALL_FAST_MODEL",
          "CLAUDE_CODE_AUTO_MODE_MODEL",
          "CLAUDE_CODE_BG_CLASSIFIER_MODEL",
          "CLAUDE_CODE_SUBAGENT_MODEL"
        ],
        "effort_environment_keys": [
          "CLAUDE_CODE_EFFORT_LEVEL",
          "CLAUDE_EFFORT"
        ]
      },
      "default_retry_attempts": 5,
      "efforts": ["low", "medium", "high", "xhigh", "max"],
      "model_family_aliases": {
        "fable": "fable",
        "opus": "opus",
        "sonnet": "sonnet",
        "haiku": "haiku"
      },
      "fallbacks": [
        {
          "model_family": "fable",
          "model": "claude-opus-5",
          "attempts": 5
        }
      ],
      "permissions": {
        "default": "dangerously_bypass",
        "read_only_override": "read_only",
        "modes": {
          "dangerously_bypass": {
            "arguments": ["--dangerously-skip-permissions"],
            "enforcement": "argument-enforced"
          },
          "read_only": {
            "arguments": ["--permission-mode", "plan"],
            "enforcement": "argument-enforced"
          }
        }
      },
      "reapply_execution_contract": true
    },
    "codex-cli": {
      "binary_env": "AGENT_LORD_CODEX_BIN",
      "default_binary": "codex",
      "default_model": "gpt-6-astra",
      "default_effort": "xhigh",
      "default_retry_attempts": 1,
      "efforts": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"],
      "permissions": {
        "default": "dangerously_bypass",
        "read_only_override": "read_only",
        "modes": {
          "dangerously_bypass": {
            "arguments": ["--dangerously-bypass-approvals-and-sandbox"],
            "enforcement": "argument-enforced"
          },
          "read_only": {
            "arguments": ["-c", "sandbox_mode=\"read-only\"", "-c", "approval_policy=\"never\""],
            "enforcement": "config-argument-enforced"
          }
        }
      },
      "reapply_execution_contract": true
    },
    "mcode-cli": {
      "same_session_continuations": 2,
      "binary_env": "AGENT_LORD_MCODE_BIN",
      "default_binary": "mcode",
      "default_model": "custom_provider:mafia-claude/claude-fable-5#xhigh",
      "default_effort": null,
      "default_retry_attempts": 1,
      "efforts": [],
      "permissions": {
        "default": "dangerously_bypass",
        "read_only_override": null,
        "read_only_supported": false,
        "modes": {
          "dangerously_bypass": {
            "arguments": ["--permission", "full"],
            "enforcement": "mcode-permission-full-argument"
          }
        }
      },
      "reapply_execution_contract": true
    },
    "codex-app": {
      "default_model": "gpt-5.6-sol",
      "default_effort": "high",
      "default_retry_attempts": 1,
      "efforts": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"],
      "list_threads_limit": 50,
      "permissions": {
        "default": "dangerously_bypass",
        "read_only_override": "read_only",
        "modes": {
          "dangerously_bypass": {
            "arguments": [],
            "enforcement": "host-inherited-unverified"
          },
          "read_only": {
            "arguments": [],
            "enforcement": "instruction-only"
          }
        }
      },
      "reapply_execution_contract": true,
      "tools": {
        "create": "codex_app__create_thread",
        "send": "codex_app__send_message_to_thread",
        "read": "codex_app__read_thread",
        "list": "codex_app__list_threads"
      }
    }
  }
}
