{
  "name": "agent-lord-observer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live observer and constrained native-terminal launcher for Agent Lord tasks",
  "license": "Apache-2.0",
  "scripts": {
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "start": "node dist/server/main.js",
    "preview:start": "node dist/server/preview.js start",
    "preview:attach": "node dist/server/preview.js attach",
    "preview:status": "node dist/server/preview.js status",
    "preview:stop": "node dist/server/preview.js stop",
    "preview:restart": "node dist/server/preview.js restart",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@agent-lord/core": "workspace:*",
    "@streamdown/cjk": "^1.0.2",
    "@streamdown/code": "^1.1.0",
    "ai": "^6.0.105",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^3.22.0",
    "streamdown": "^2.4.0",
    "tailwind-merge": "^3.4.0",
    "use-stick-to-bottom": "^1.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
